 !-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 ! MODEL  BFM - Biogeochemical Flux Model version 2.50
 !-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
+
+!-----------------------------------------------------------------------------
+! SiltFluffFluxes (method 5, Baretta & Ruardij 1988)
+! Moves the net resuspension jrESS (mg/m2/d, calculated in SiltDynamics)
+! between the fluff layer Q8x and the bottom water layer of R9x.
+! jrESS > 0: fluff layer -> water; jrESS < 0: water -> fluff layer.
+!-----------------------------------------------------------------------------
+subroutine SiltFluffFluxes
+
+use global_mem, ONLY: RLEN, ZERO
+use mem, ONLY: ppR9x, ppQ8x, jrESS, Depth, NO_BOXES, iiPel, iiBen, &
+flux_vector
+use mem_Silt, ONLY: method
+
+IMPLICIT NONE
+REAL(RLEN), dimension(NO_BOXES) :: rate
+
+if (method /=5) return
+
+! water column: only the bottom layer (box 1) exchanges with the bed
+rate=ZERO
+rate(1)=jrESS(1)/Depth(1)  ! mg/m3/d
+call flux_vector(iiPel, ppR9x, ppR9x, rate)
+
+! fluff layer: loses what goes into the water, gains what settles
+call flux_vector(iiBen, ppQ8x, ppQ8x, -jrESS) ! mg/m2/d 
+
+end subroutine SiltFluffFluxes
