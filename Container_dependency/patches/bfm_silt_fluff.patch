             R9x(:)=1000.0
         end select
 
+       case (5)          ! Baretta & Ruardij (1988), fluff layer Q8x
+         ! wind effect, eq. 5.3: more wind -> smaller fraction going down
+         pDOWN=p_pDOWN0*p_W50/(p_W50+max(ZERO,Wind-p_minwind))
+
+         ! no settling through GOTM: sedimentation is calculated here
+         ws(:,ppR9x)=ZERO
+
+         ! depth-mean suspended silt (mg/m3)
+         Mbar=sum(R9x(1:NO_BOXES)*Depth(1:NO_BOXES))/tdepth
+
+         ! gross sedimentation, eq. 5.4 (mg/m2/d): silt settling out of a
+         ! water layer of p_seddep above the bed, p_rtid times per day
+         sed=p_rtid*p_seddep*pDOWN*R9x(1)
+
+         ! gross resuspension, eq. 5.5 (mg/m2/d): total mud = suspended silt
+         ! + fluff layer spread over the water column
+         resus=p_rtid*p_resdep*(DONE-pDOWN)*(Mbar+Q8x(1)/tdepth)
+
+         ! within one time step, take no more than each pool holds
+         resus=min(resus, Q8x(1)/delta)
+         sed=min(sed, R9x(1)*Depth(1)/delta)
+
+         ! net resuspension (>0) or sedimentation (<0), mg/m2/d
+         jrESS=resus-sed
+
+         ! effective settling velocity (m/d): detritus bound to silt sinks with it
+         sediR9=ZERO
+         sediR9(1)=p_rtid*p_seddep*pDOWN
+         ws_out=ZERO
+
+         select case (InitializeModel)
+           case (1)
+             R9x(:)=1000.0
+         end select
+
      end select
 
   end
